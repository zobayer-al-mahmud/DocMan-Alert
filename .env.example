# Ananta DocMan Alert - environment configuration
#
# On Windows, set these as USER or SYSTEM environment variables so the app and
# the Task Scheduler jobs (which run without a logged-in user) can both read
# them, e.g.:
#     setx SECRET_KEY "a-long-random-value"
# Then open a NEW terminal / restart the service for changes to take effect.
#
# This file documents every variable. It is NOT read automatically unless you
# use a tool that loads .env files; it exists as a reference and template.

# --- Required secret (no default; app refuses to start without it) ----------
SECRET_KEY=change-me-to-a-long-random-string

# --- SMTP / email ----------------------------------------------------------
SMTP_HOST=192.168.10.6
SMTP_PORT=25
SMTP_USE_TLS=0
SMTP_USE_SSL=0
SMTP_USERNAME=document_tracker@ananta.com.bd
SMTP_PASSWORD=
SMTP_SENDER=document_tracker@ananta.com.bd

# Legacy setting. Alert delivery now uses company, department, and record
# recipients stored in the database (users.email). This variable is not used
# to choose who receives compliance email.
# ALERT_RECIPIENTS=

# --- File storage ----------------------------------------------------------
# Leave unset to use app/uploads. Set to an absolute path to store files
# outside the application folder in production.
# UPLOAD_FOLDER=D:\ComplianceData\uploads

# --- Backups ---------------------------------------------------------------
# BACKUP_FOLDER=D:\ComplianceData\backups
# Optional second backup target (mirror). Keep on a different disk/share.
# BACKUP_MIRROR_FOLDER=\\fileserver\compliance_backups
BACKUP_RETENTION_DAYS=30

# --- HTTPS / cookies -------------------------------------------------------
# Set to 1 once the app is served over HTTPS behind the internal reverse proxy.
SESSION_COOKIE_SECURE=0

# --- Local OCR (Tesseract). Documents are not sent to a cloud service. ----
# Install Tesseract, then confirm: tesseract --list-langs
# Expected languages: eng and ben
OCR_ENABLED=1
# Defaults to the standard Windows install path when that file exists.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Folder that contains eng.traineddata and ben.traineddata.
# TESSDATA_PREFIX=D:\Compliance Tracker\tessdata
OCR_LANGUAGES=eng+ben
OCR_MAX_FILE_MB=10
OCR_MAX_PDF_PAGES=50
OCR_TIMEOUT_SECONDS=120
